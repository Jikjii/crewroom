{
  "expo": {
    "name": "Crewroom",
    "slug": "crewroom",
    "owner": "geraldogs-team",
    "extra": {
      "eas": {
        "projectId": "7e2b8c93-ce85-47b1-b0a5-ccf81c3d8d06"
      }
    },
    "scheme": "crewroom",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F5F0",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/crewroom-adaptive.png",
        "backgroundColor": "#335BD6",
        "monochromeImage": "./assets/crewroom-monochrome.png"
      }
    },
    "web": {
      "name": "Crewroom",
      "shortName": "Crewroom",
      "backgroundColor": "#F6F5F0",
      "themeColor": "#335BD6",
      "favicon": "./assets/crewroom-favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or photos and videos for your Crewroom projects.",
          "cameraPermission": "Take a profile photo or record a short cosplay video on Crewroom.",
          "microphonePermission": "Record sound with your Crewroom videos."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "icon": "./assets/crewroom-icon.png"
  }
}
