# Local development: npm run dev:phone supplies public addresses automatically.
# Hosting: set these in your host environment. These are the chosen public
# beta settings; the domain still needs to be connected to the hosted service.
# NODE_ENV=production
# APP_ORIGIN=https://joincrewroom.com
# EXPO_PUBLIC_API_URL=https://joincrewroom.com
# EXPO_PUBLIC_WEB_URL=https://joincrewroom.com
# DATA_DIR=/var/data
# OPERATOR_NAME="Geraldo Grell"
# SUPPORT_EMAIL=support@joincrewroom.com
# MINIMUM_AGE=18
# POLICY_VERSION=beta-1
# POLICIES_APPROVED=false
# TRUST_PROXY_HOPS=0
# Review DEPLOY.md before approving policies or trusting a proxy.

# Password-recovery and beta-signup confirmation delivery. Set BOTH using a verified sender.
# RESEND_API_KEY=
# MAIL_FROM=
# These two are server-only secrets, never EXPO_PUBLIC_ variables.

# EAS native builds: provide your final identifier and Expo project's UUID.
# CREWROOM_APP_ID=
# EAS_PROJECT_ID=
# The public HTTPS URL variables above must also be set in each EAS environment.

# Optional storage overrides instead of DATA_DIR:
# DB_PATH=/absolute/persistent/path/crewroom.sqlite
# MEDIA_DIR=/absolute/persistent/path/media

# Automatic offsite backups: private Cloudflare R2 Standard bucket, server only.
# Enable only after creating the bucket, applying a 7-day lifecycle rule to the
# prefix, and entering a bucket-scoped Object Read & Write credential in Render.
# BACKUP_ENABLED=false
# BACKUP_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=crewroom-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_PREFIX=crewroom-beta/v1
# BACKUP_RETENTION_DAYS=7
# BACKUP_MAX_BYTES=1073741824
# Daily snapshots include the database and referenced uploaded photos. R2 encrypts
# objects at rest; transfers use HTTPS. Do not expose this bucket publicly.
# Moderation desk: immutable account IDs only. Never grant the shared Apple review account access.
MODERATION_OPERATOR_IDS=
# Safe rollout default; prepare/verify vendor workflows and policy disclosures before switching.
MODERATION_MODE=manual
MODERATION_PROVIDER_APPROVED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_IMAGE_WORKFLOW=
SIGHTENGINE_VIDEO_WORKFLOW=
SIGHTENGINE_WORKFLOWS_VERIFIED=false
SIGHTENGINE_AUDIO_MODERATION_ENABLED=false
