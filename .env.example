# Local development: npm run dev:phone supplies public addresses automatically.
# Hosting: set these in your host environment. These are the chosen public
# beta settings; the domain still needs to be connected to the hosted service.
# NODE_ENV=production
# APP_ORIGIN=https://joincrewroom.com
# EXPO_PUBLIC_API_URL=https://joincrewroom.com
# EXPO_PUBLIC_WEB_URL=https://joincrewroom.com
# DATA_DIR=/var/data
# OPERATOR_NAME="Geraldo Grell"
# SUPPORT_EMAIL=support@joincrewroom.com
# MINIMUM_AGE=18
# POLICY_VERSION=beta-1
# POLICIES_APPROVED=false
# TRUST_PROXY_HOPS=0
# Review DEPLOY.md before approving policies or trusting a proxy.

# Optional password-recovery delivery. Set BOTH using a verified sender.
# RESEND_API_KEY=
# MAIL_FROM=
# These two are server-only secrets, never EXPO_PUBLIC_ variables.

# EAS native builds: provide your final identifier and Expo project's UUID.
# CREWROOM_APP_ID=
# EAS_PROJECT_ID=
# The public HTTPS URL variables above must also be set in each EAS environment.

# Optional storage overrides instead of DATA_DIR:
# DB_PATH=/absolute/persistent/path/crewroom.sqlite
# MEDIA_DIR=/absolute/persistent/path/media
